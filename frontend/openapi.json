{
  "openapi": "3.1.0",
  "info": {
    "title": "Wellness Robot contracts",
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ExerciseId": {
        "enum": [
          "grounding_54321",
          "box_breathing",
          "thought_record",
          "smallest_steps",
          "winddown",
          "consistency_checkin"
        ],
        "title": "ExerciseId",
        "type": "string"
      },
      "Expression": {
        "enum": [
          "neutral",
          "warm",
          "soft",
          "curious",
          "happy",
          "calm"
        ],
        "title": "Expression",
        "type": "string"
      },
      "Gesture": {
        "enum": [
          "none",
          "wave",
          "nod",
          "hand_on_chest",
          "open_palms",
          "count",
          "point_to_light",
          "thumbs_up",
          "palm_out",
          "clap",
          "open_arms"
        ],
        "title": "Gesture",
        "type": "string"
      },
      "Resource": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "contact": {
            "title": "Contact",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "verifiedOn": {
            "format": "date",
            "title": "Verifiedon",
            "type": "string"
          }
        },
        "required": [
          "name",
          "contact",
          "country",
          "verifiedOn"
        ],
        "title": "Resource",
        "type": "object"
      },
      "RiskLevel": {
        "enum": [
          "none",
          "elevated",
          "high"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "Segment": {
        "properties": {
          "say": {
            "minLength": 1,
            "title": "Say",
            "type": "string"
          },
          "expression": {
            "$ref": "#/components/schemas/Expression"
          },
          "gesture": {
            "$ref": "#/components/schemas/Gesture"
          },
          "count": {
            "anyOf": [
              {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Count"
          }
        },
        "required": [
          "say",
          "expression",
          "gesture"
        ],
        "title": "Segment",
        "type": "object"
      },
      "Turn": {
        "properties": {
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "mode": {
            "enum": [
              "normal",
              "safe"
            ],
            "title": "Mode",
            "type": "string"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Segments",
            "type": "array"
          },
          "exercise": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExerciseId"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "title": "Resources",
            "type": "array"
          }
        },
        "required": [
          "risk",
          "mode",
          "segments"
        ],
        "title": "Turn",
        "type": "object"
      }
    }
  }
}
