{
  "openapi": "3.1.0",
  "info": {
    "title": "Wellness Robot API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/turn": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turn"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tts/status": {
      "get": {
        "summary": "Tts Status",
        "operationId": "tts_status_tts_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSStatus"
                }
              }
            }
          }
        }
      }
    },
    "/tts": {
      "post": {
        "summary": "Tts",
        "operationId": "tts_tts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TTSRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExerciseId": {
        "type": "string",
        "enum": [
          "grounding_54321",
          "box_breathing",
          "thought_record",
          "smallest_steps",
          "winddown",
          "consistency_checkin"
        ],
        "title": "ExerciseId"
      },
      "Expression": {
        "type": "string",
        "enum": [
          "neutral",
          "warm",
          "soft",
          "curious",
          "happy",
          "calm"
        ],
        "title": "Expression"
      },
      "Gesture": {
        "type": "string",
        "enum": [
          "none",
          "wave",
          "nod",
          "hand_on_chest",
          "open_palms",
          "count",
          "point_to_light",
          "thumbs_up",
          "palm_out",
          "clap",
          "open_arms"
        ],
        "title": "Gesture"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryItem": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "robot"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "HistoryItem"
      },
      "Resource": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "contact": {
            "type": "string",
            "title": "Contact"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "verifiedOn": {
            "type": "string",
            "format": "date",
            "title": "Verifiedon"
          }
        },
        "type": "object",
        "required": [
          "name",
          "contact",
          "country",
          "verifiedOn"
        ],
        "title": "Resource"
      },
      "RiskLevel": {
        "type": "string",
        "enum": [
          "none",
          "elevated",
          "high"
        ],
        "title": "RiskLevel"
      },
      "Segment": {
        "properties": {
          "say": {
            "type": "string",
            "minLength": 1,
            "title": "Say"
          },
          "expression": {
            "$ref": "#/components/schemas/Expression"
          },
          "gesture": {
            "$ref": "#/components/schemas/Gesture"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "say",
          "expression",
          "gesture"
        ],
        "title": "Segment"
      },
      "TTSRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TTSRequest"
      },
      "TTSStatus": {
        "properties": {
          "elevenlabs": {
            "type": "boolean",
            "title": "Elevenlabs"
          }
        },
        "type": "object",
        "required": [
          "elevenlabs"
        ],
        "title": "TTSStatus"
      },
      "Turn": {
        "properties": {
          "risk": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "safe"
            ],
            "title": "Mode"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Segments"
          },
          "exercise": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExerciseId"
              },
              {
                "type": "null"
              }
            ]
          },
          "exercise_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Exercise Steps"
          },
          "plan_step": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Step"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "type": "array",
            "title": "Resources"
          }
        },
        "type": "object",
        "required": [
          "risk",
          "mode",
          "segments"
        ],
        "title": "Turn"
      },
      "TurnRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          },
          "safe_locked": {
            "type": "boolean",
            "title": "Safe Locked",
            "default": false
          },
          "current_step": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Step"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "TurnRequest",
        "description": "Body of POST /turn. History lives in the browser's memory only."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
